#!/usr/bin/env bash
# =============================================================================
# CymbalGoal Lab 1 — startup VM provisioning script
# =============================================================================
# Everything Terraform structurally cannot do, in the only order that works.
# Runs unattended; every failure must be loud in the serial console, because
# nobody is watching this live.
#
#   journalctl -u google-startup-scripts -f     # to follow it
#   gcloud compute instances get-serial-port-output cymbalgoal-startup
#
# Measured on a live PG 18.3 cluster, 8 vCPU:
#   pass 1 (8 tables, 832,193 appearances)  82 s
#   pass 2 (14,235 profiles)                14 s
#   ScaNN players / clubs                   27 s / 18 s
#   TOTAL                                  ~2.5 min
# =============================================================================

set -uo pipefail
exec > >(tee /var/log/cymbalgoal-provision.log) 2>&1

PROJECT="${project_id}"
REGION="${region}"
CLUSTER="${cluster_id}"
INSTANCE="${instance_id}"
DB="${db_name}"
PGHOST_="${db_host}"
GCS="${gcs_prefix}"
STUDENT="${student}"

export PGHOST="$PGHOST_"
export PGUSER="postgres"
export PGPASSWORD='${db_password}'
export PGDATABASE="postgres"
export PAGER=cat PSQL_PAGER=cat

step() { echo; echo "===== $* ====="; }
die()  { echo "!!!!! PROVISION FAILED: $* !!!!!"; exit 1; }

step "0. Tools"
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq postgresql-client jq || die "apt install"

# Wait for the instance to accept connections. Terraform reports the instance
# ready, but there is a short window before the listener answers.
for i in $(seq 1 60); do
  psql -X -c "SELECT 1" >/dev/null 2>&1 && break
  echo "  waiting for AlloyDB ($i/60)"; sleep 10
done
psql -X -c "SELECT version();" || die "cannot reach AlloyDB at $PGHOST"

# -----------------------------------------------------------------------------
step "1. Create the database (no Terraform resource exists for this)"
# -----------------------------------------------------------------------------
psql -X -tc "SELECT 1 FROM pg_database WHERE datname='$DB'" | grep -q 1 \
  || psql -X -c "CREATE DATABASE $DB;" || die "create database"
export PGDATABASE="$DB"

# -----------------------------------------------------------------------------
step "2. Data API access (no Terraform, no gcloud — raw v1alpha PATCH)"
# -----------------------------------------------------------------------------
# P-08: which enum does it want? Unresolved at time of writing, so try the
# documented candidates and report. This is NOT fatal for Lab 1 — Lab 2 needs
# it — so log loudly and continue rather than killing the provision.
TOKEN=$(gcloud auth print-access-token)
URL="https://alloydb.googleapis.com/v1alpha/projects/$PROJECT/locations/$REGION/clusters/$CLUSTER/instances/$INSTANCE?updateMask=clientConnectionConfig.requireConnectors,observabilityConfig.enabled"
for ENUM in ENABLED ALLOW_DATA_API; do
  echo "--- trying dataApiEnabled enum: $ENUM ---"
  curl -s -X PATCH -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" \
    "https://alloydb.googleapis.com/v1alpha/projects/$PROJECT/locations/$REGION/clusters/$CLUSTER/instances/$INSTANCE?updateMask=dataApiEnabled" \
    -d "{\"dataApiEnabled\":\"$ENUM\"}" | head -20
done

# -----------------------------------------------------------------------------
step "3. Extensions"
# -----------------------------------------------------------------------------
# BM25 and the Index Advisor both require alloydbsuperuser. We connect as
# postgres, which holds it.
psql -X -v ON_ERROR_STOP=1 <<'SQL' || die "extensions"
CREATE EXTENSION IF NOT EXISTS vector;
CREATE EXTENSION IF NOT EXISTS alloydb_scann;
CREATE EXTENSION IF NOT EXISTS google_ml_integration;
CREATE EXTENSION IF NOT EXISTS pg_textsearch;
SELECT extname, extversion FROM pg_extension ORDER BY extname;
SQL

step "3b. Assert google_ml_integration meets the floor (P-12)"
# Measured 1.6 on PG 18.3. Floor is 1.5.2. Fail loudly, not silently — a lab
# that comes up on an old extension breaks at Task 5, not at provision time.
psql -X -v ON_ERROR_STOP=1 <<'SQL' || die "google_ml_integration below floor"
DO $$
DECLARE v TEXT;
BEGIN
  SELECT extversion INTO v FROM pg_extension WHERE extname='google_ml_integration';
  RAISE NOTICE 'google_ml_integration version: %', v;
  IF string_to_array(v,'.')::int[] < ARRAY[1,5] THEN
    RAISE EXCEPTION 'google_ml_integration % is below the 1.5.2 floor', v;
  END IF;
END $$;
SQL

# -----------------------------------------------------------------------------
step "4. Schema — then drop the ScaNN indexes it creates"
# -----------------------------------------------------------------------------
# schema.sql creates the two ScaNN indexes itself, on empty tables.
#
# MEASURED: leaving them in place is actually 39 s FASTER overall (incremental
# maintenance costs 6 s; building from scratch costs 45 s). We drop and rebuild
# anyway, because 45 s is 0.4% of a 15-18 min provision and it guarantees
# centroids trained on the real distribution rather than on zero rows.
#
# NO REGEX SPLITTING of the DDL — that is explicitly forbidden. Apply whole,
# then DROP by name.
mkdir -p /opt/cg && cd /opt/cg
gcloud storage cp "$GCS/schema.sql"        . || die "fetch schema.sql"
gcloud storage cp "$GCS/manifest.json"     . || die "fetch manifest.json"
gcloud storage cp "$GCS/load_profiles.sql" . || die "fetch load_profiles.sql"

psql -X -v ON_ERROR_STOP=1 -f schema.sql || die "apply schema"
psql -X -c "DROP INDEX IF EXISTS players_profile_embedding_scann_idx;"
psql -X -c "DROP INDEX IF EXISTS clubs_profile_embedding_scann_idx;"

# -----------------------------------------------------------------------------
step "5. PASS 1 — eight relational tables, explicit column lists"
# -----------------------------------------------------------------------------
# The manifest's column_order is DDL-derived: for players and clubs it includes
# profile_text and profile_embedding, which the pass-1 CSVs do NOT carry (pass 2
# owns them). Take it as authoritative for ORDER, then subtract the pass-2
# columns. Never positional, never guessed.
python3 - <<'PY' > /opt/cg/cols.env || die "parse manifest"
import json
PASS2 = {'profile_text', 'profile_embedding'}
m = json.load(open('/opt/cg/manifest.json'))
sf = m.get('staged_files')
items = sf.items() if isinstance(sf, dict) else [(f.get('name'), f) for f in sf]
for k, v in items:
    if not isinstance(v, dict): continue
    tbl = str(k).split('/')[-1].replace('.csv.gz','').replace('.csv','')
    co = v.get('column_order')
    if co:
        print(f'COLS_{tbl}="{",".join(c for c in co if c not in PASS2)}"')
PY
source /opt/cg/cols.env

# PREFLIGHT. A column list that is LONGER than the file errors loudly. One that
# is the same length but differently ordered loads SILENTLY into the wrong
# columns — stadium capacity into market value — and the first symptom is a lab
# task returning nonsense on stage. Refuse to load on any mismatch.
step "5a. Preflight — field count vs column list"
for t in competitions clubs players games appearances game_events player_valuations transfers; do
  var="COLS_$t"; cols="$${!var:-}"
  [ -z "$cols" ] && die "no column_order for $t in manifest"
  n_cols=$(awk -F, '{print NF}' <<<"$cols")
  n_file=$(gcloud storage cat "$GCS/$t.csv.gz" | gunzip -c | head -1 \
           | python3 -c "import sys,csv
try: print(len(next(csv.reader(sys.stdin))))
except Exception: print(0)")
  [ "$n_cols" = "$n_file" ] || die "$t column mismatch: list=$n_cols file=$n_file"
  echo "  $t: $n_cols columns OK"
done

step "5b. Load — parents before children"
T0=$(date +%s)
for t in competitions clubs players games appearances game_events player_valuations transfers; do
  var="COLS_$t"; cols="$${!var}"
  echo "--- $t ---"
  gcloud storage cat "$GCS/$t.csv.gz" | gunzip -c \
    | psql -X -v ON_ERROR_STOP=1 -c "\copy $t ($cols) FROM STDIN WITH (FORMAT csv)" \
    || die "load $t"
done
echo ">>> pass 1: $(($(date +%s)-T0)) s"

# -----------------------------------------------------------------------------
step "6. PASS 2 — profiles"
# -----------------------------------------------------------------------------
# load_profiles.sql streams both gzipped CSVs from GCS itself via
# \copy ... FROM PROGRAM, wrapped in BEGIN/COMMIT with ON_ERROR_STOP on, so an
# assertion failure rolls back rather than half-loading.
T0=$(date +%s)
psql -X -f load_profiles.sql || die "pass 2 (load_profiles.sql)"
echo ">>> pass 2: $(($(date +%s)-T0)) s"

step "6b. The assertion load_profiles.sql is MISSING"
# It computes n_clubs, prints it in a NOTICE, and never checks it. A zero-row
# clubs load passes silently — and we saw exactly that failure mode during
# testing when clubs failed pass 1 while players succeeded. Close it here rather
# than regenerating the staged artifact.
psql -X -v ON_ERROR_STOP=1 <<'SQL' || die "club profile load short"
DO $$
DECLARE n BIGINT;
BEGIN
  SELECT count(*) INTO n FROM clubs WHERE profile_embedding IS NOT NULL;
  RAISE NOTICE 'club profiles: %', n;
  IF n < 790 THEN
    RAISE EXCEPTION 'club profile load short: got %, expected 796', n;
  END IF;
END $$;
SQL

# -----------------------------------------------------------------------------
step "7. ScaNN indexes — AFTER the load"
# -----------------------------------------------------------------------------
# num_leaves ~ sqrt(rows): 116 for 13,439 players, 28 for 796 clubs.
# maintenance_work_mem below total machine memory (P-16).
T0=$(date +%s)
psql -X -v ON_ERROR_STOP=1 <<'SQL' || die "scann players"
SET maintenance_work_mem='4GB';
CREATE INDEX players_profile_embedding_scann_idx ON players
USING scann (profile_embedding cosine) WITH (num_leaves=116, quantizer='sq8');
SQL
psql -X -v ON_ERROR_STOP=1 <<'SQL' || die "scann clubs"
SET maintenance_work_mem='4GB';
CREATE INDEX clubs_profile_embedding_scann_idx ON clubs
USING scann (profile_embedding cosine) WITH (num_leaves=28, quantizer='sq8');
SQL
echo ">>> scann: $(($(date +%s)-T0)) s"

# ⚠️ DO NOT create the BM25 index. Building it is Lab 1 Task 3 — it is the lab.

psql -X -c "ANALYZE players;" -c "ANALYZE clubs;"

# -----------------------------------------------------------------------------
step "8. Grants + completion marker"
# -----------------------------------------------------------------------------
psql -X -c "GRANT ALL ON ALL TABLES IN SCHEMA public TO \"$STUDENT\";" || true
psql -X -c "GRANT ALL ON SCHEMA public TO \"$STUDENT\";" || true

# Not a readiness *mechanism* — provisioning is pre-warmed and Task 1 opens with
# a row-count query. This is for the instructor guide's pre-flight check: one
# table to look at that says whether provisioning finished and when.
psql -X -v ON_ERROR_STOP=1 <<'SQL'
CREATE TABLE IF NOT EXISTS provisioning_status (
  finished_at timestamptz PRIMARY KEY DEFAULT now(),
  players     bigint,
  clubs       bigint,
  appearances bigint
);
INSERT INTO provisioning_status (players, clubs, appearances)
SELECT (SELECT count(*) FROM players  WHERE profile_embedding IS NOT NULL),
       (SELECT count(*) FROM clubs    WHERE profile_embedding IS NOT NULL),
       (SELECT count(*) FROM appearances);
SQL

psql -X -c "SELECT * FROM provisioning_status;"

echo
echo "==================================================="
echo " CYMBALGOAL PROVISIONING COMPLETE"
echo "==================================================="
